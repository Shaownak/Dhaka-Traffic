# Copy to .env and fill in what you need. NOTHING here is required to run the
# page (`npm run dev`) or the API (`npm run api`) — every key is for an offline
# collection script.
#
# .env is gitignored. Never commit a real key, and never expose one to the
# frontend: a static page has no server to hide it behind.

# --- Journey time collection (billed per request) -------------------------
# Google Routes API, used by scripts/collect-network-times.mjs and
# scripts/collect-corridor-speeds.mjs to sample how long trips actually take.
#
# SET A DAILY QUOTA CAP IN THE GOOGLE CLOUD CONSOLE BEFORE THE FIRST REAL RUN.
# `npm run plan:sampling` prints the request volumes to expect: roughly
# 936/day flat, or 1,950/day peak-weighted.
GOOGLE_ROUTES_KEY=

# --- Air quality (free) ---------------------------------------------------
# OpenAQ v3. Get a key at explore.openaq.org.
OPENAQ_KEY=

# --- API server -----------------------------------------------------------
# Port for `npm run api`. Defaults to 8787.
PORT=8787

# No key is needed for OpenStreetMap/Overpass (places) or Open-Meteo (weather).
