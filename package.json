{
  "name": "seven-kilometres-an-hour",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual data story about traffic congestion in Dhaka.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/start.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "journey": "node scripts/journey.mjs",
    "audit:network": "node scripts/network-audit.mjs",
    "collect:places": "node scripts/collect-places.mjs",
    "collect:times": "node scripts/collect-network-times.mjs",
    "build:times": "node scripts/build-network-times.mjs",
    "plan:sampling": "node scripts/sampling-plan.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-transition": "^3.0.9",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
